# ─────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha os valores reais
# NUNCA suba o .env para o Git (está no .gitignore)
# ─────────────────────────────────────────────────────────────

# Token de acesso do Mercado Pago
# Obtenha em: https://www.mercadopago.com.br/developers/panel
# Crie um app → Credenciais → Access Token de PRODUÇÃO
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL pública do Railway (preencha após o primeiro deploy)
# Exemplo: https://casamento-lw-production.up.railway.app
APP_URL=https://SEU-APP.up.railway.app

# Conexão com o banco Supabase
# Obtenha em: supabase.com → seu projeto → Settings → Database → Connection string (URI)
# Use a connection string no formato: postgresql://postgres:[SENHA]@[HOST]:5432/postgres
DATABASE_URL=postgresql://postgres:SENHA@HOST:5432/postgres

# Porta (Railway define automaticamente — não altere)
PORT=3000
